# Anthropic API key for Claude (chat with personalities — preferred provider)
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API key (fallback if ANTHROPIC_API_KEY is unset)
# Models default to gpt-4.1-mini for both tiers (non-reasoning, fast)
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Mistral API key for Voxtral (speech-to-text)
# Get one at https://console.mistral.ai/
MISTRAL_API_KEY=
